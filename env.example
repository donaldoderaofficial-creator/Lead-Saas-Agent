# ============================================
# Dispatch Pro - Environment Configuration
# ============================================
# This file documents all available environment variables.
# Copy this to .env and fill in your values.

# ---- Environment ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Session & Security ----
SESSION_SECRET=choose-a-long-random-string-for-production
CORS_ORIGINS=http://localhost:3000,https://lead-saas-agent.netlify.app,https://agent-6a81dca937d9510b5c359--dispatch-lead-agent.netlify.app
PUBLIC_APP_URL=https://lead-saas-agent.netlify.app

# ---- Database ----
DB_PATH=./data.db
TZ=Africa/Nairobi

# ---- Logging & Monitoring ----
LOG_FILE=./logs/app.log
LOG_LEVEL=debug

# Crypto conversion estimates used to display manual-payment amounts.
BTC_USD_PRICE=70000
ETH_USD_PRICE=3500

# ============================================
# Payment Providers (Optional)
# ============================================

# ---- PayPal ----
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-secret
PAYPAL_MODE=sandbox
# PAYPAL_MODE=live  (for production)
PAYPAL_WEBHOOK_ID=your-webhook-id

# ---- M-Pesa ----
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORT_CODE=174379
# Legacy alias also accepted: MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_ENV=sandbox
# MPESA_ENV=production    (live is also accepted)
MPESA_CALLBACK_URL=https://your-public-url/payments/mpesa/callback
# Register these C2B URLs for QR/merchant confirmations:
# https://your-public-url/payments/mpesa/c2b/validation
# https://your-public-url/payments/mpesa/c2b/confirmation
MPESA_TEST_PHONE=254112217747
# Dynamic QR generation uses MPESA_SHORT_CODE as CPI.

# ============================================
# Third-Party APIs (Optional)
# ============================================

# ---- Explorium (Prospecting) ----
EXPLORIUM_API_KEY=your-explorium-api-key

# ---- Error Tracking (Optional) ----
ERROR_TRACKING_KEY=your-sentry-or-rollbar-key

# ============================================
# Feature Flags (Control Features)
# ============================================

FEATURE_PROSPECTING=true
FEATURE_WEBHOOKS=true
FEATURE_COMPLIANCE=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_2FA=true

# ============================================
# Pricing Configuration (Flexible)
# ============================================
# Prices can be configured here (or in config.js)
# Example: PRICING_STARTER_USD=9.99

# ============================================
# PayPal Subscription Plans (Setup Script)
# ============================================
PAYPAL_PLAN_STARTER_MONTHLY=your-starter-plan-id-from-setup-script
PAYPAL_PLAN_GROWTH_MONTHLY=your-growth-plan-id-from-setup-script
# PayPal subscription webhook events must include:
# BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.CANCELLED,
# BILLING.SUBSCRIPTION.SUSPENDED

# Crypto subscription payments require owner/admin review:
# POST /api/billing/crypto/order
# POST /api/billing/crypto/confirm
# POST /api/billing/crypto/review/:reference

